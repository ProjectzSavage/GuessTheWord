local function makeCornerScale(inst, scaleRadius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(scaleRadius, 0)
	c.Parent = inst
	return c
end

local function makeStroke(inst, color, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Parent = inst
	return s
end

